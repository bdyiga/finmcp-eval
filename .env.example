# Copy to .env and fill in. Never commit .env.

# --- Gemini (default backend) ---
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Any model your key can use with function calling. Free-tier models change; check
# https://ai.google.dev/gemini-api/docs/pricing before running.
GEMINI_MODEL=gemini-3.8-flash
# Seconds between Gemini requests (6 = at most 10 requests/minute).
GEMINI_MIN_INTERVAL_SECONDS=6

# --- SEC EDGAR (required for the with_tools mode) ---
# SEC requires a User-Agent with a name and contact email: https://www.sec.gov/os/accessing-edgar-data
SEC_CONTACT_NAME=Your Name
SEC_CONTACT_EMAIL=you@example.com

# --- Generation settings (shared by both modes) ---
MODEL_TEMPERATURE=0
MODEL_MAX_OUTPUT_TOKENS=2048
MODEL_SEED=1234

# --- Cache ---
FINMCP_CACHE_DIR=cache
# Reuse cached SEC files for this many days (0 = never expire).
FINMCP_CACHE_TTL_DAYS=30

# --- Optional local fallback: Ollama ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
